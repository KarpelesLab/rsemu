# amiga-a500 - a Commodore Amiga 500: the map, both CIAs and the chipset.
#
#   rsemu run amiga-a500 --media kickstart=kick.rom
#   rsemu run amiga-a500 -p chip-ram=1M --media kickstart=kick.rom
#   rsemu run amiga-a500 --media kickstart=kick.rom --vnc :5900
#   rsemu run amiga-a500 -p slow-ram=512K --media kickstart=kick.rom
#
# AROS, whose ROM comes in two halves, needs the extended-ROM socket this
# board carries for it and a real A500 does not (see `gary` below):
#
#   rsemu run amiga-a500 -p chip-ram=1M -p slow-ram=512K \
#       --media kickstart=aros.rom --media ext=aros-ext.rom --media df0=aros-boot.adf
#
# The picture, the keyboard and the mouse reach a person through `--vnc`: the
# session serves Denise's picture and types and points at the keyboard and
# mouse at the bottom of this file. Without it, the terminal is attached to
# Paula's UART, which is what a serial console is.
#
# The map and the two decoders that make it work: chip RAM at zero, the custom
# chip registers at $DFF000, the Kickstart ROM at the top of the space, and the
# `OVL` overlay that puts the ROM at zero as well until software says
# otherwise.
#
# And the two 8520 CIAs, decoded where Appendix F puts them, with CIA-A's PA0
# driving the overlay; Paula, through which every interrupt reaches the
# processor; Agnus, which counts the beam, runs the copper and the blitter and
# makes every DMA transfer; and Denise, which turns the lines Agnus hands it
# into a picture. `custom` counts every access it could not route, which on
# this board should be none that reach a chip register.
#
# Written from the Amiga Hardware Reference Manual (Commodore-Amiga Inc., 3rd
# edition): Appendix D for the address map, Appendix B for the register table.
# No Amiga emulator source was consulted; they are all copyleft (ROADMAP.md 1).
#
# ---------------------------------------------------------------------------
# Big-endian, and it is the board's job to say so
# ---------------------------------------------------------------------------
#
# rsemu carries byte order per *region*, not per initiator, so nothing checks
# that a machine put a 68000 on a big-endian map - get it wrong and every word
# is swapped and the reset vector points somewhere absurd. `m68k-mini.machine`
# has the long version. Every `map` below either says `endian = "big"` or
# names a region that declares it (`amiga.custom` does, because a word-wide
# big-endian register file is a fact about the chips rather than about the
# board).
#
# ---------------------------------------------------------------------------
# The CIAs
# ---------------------------------------------------------------------------
#
# From the manual's Appendix F ("8520 Complex Interface Adapters") and the
# port-assignment table in Appendix E:
#
#   CIA-A   $BFEr01   data bits 7-0,  chip select A12*   "can generate INT2"
#   CIA-B   $BFDr00   data bits 15-8, chip select A13*   "can generate INT6"
#
# where `r` is the register, 0-F. So the sixteen registers are 256 bytes apart,
# each chip answers on one half of the data bus, and only one chip is ever
# selected by one access: CIA-A's select is A12 *low* (and its window has A13
# high), CIA-B's is A13 low (with A12 high). A word read at $BFE000 is CIA-A's
# register 0 in the low byte and nothing in the high byte, not both chips.
#
# `mos.8520` publishes its registers back to back and decodes nothing, so the
# spreading-out and the lane are the board's, in `amiga.cia-decode`. Both
# windows start on the even address, so the window's own parity is the address
# parity the lane is decided by.
#
# The clock is the 68000's E clock, one tenth of the processor clock (Appendix
# F: ".709379 Mhz PAL", ".715909 Mhz NTSC"). It is written against the crystal
# like every other clock on the board: the processor is `clk / 4`, which makes
# the E clock `clk / 40`. (`cpu / 10` would say the same thing.)
#
# The TOD inputs: CIA-A's counts a 50/60 Hz event - "VSync or line tick" - and
# CIA-B's counts horizontal sync. Agnus drives both, at the bottom of the file.
#
# What is not wired yet, and why:
#
# * Game port 1's fire button on PA7, the LED on PA1, the Centronics port on
#   CIA-A port B and CIA-B's PA0-PA2, and the serial handshakes on CIA-B's
#   PA3-PA7. Every one of those pins is a pull-up with nothing on it, which is
#   what a machine with nothing plugged in looks like: an unpressed button, no
#   printer, no modem. The keyboard (SP, CNT) and the mouse's left button (PA6)
#   are wired at the bottom of the file.

# ---------------------------------------------------------------------------
# What is deliberately not mapped, and what an access to it does
# ---------------------------------------------------------------------------
#
# $20 0000 - $9F FFFF   the primary autoconfig space: nothing to configure
# $D8 0000 - $DB FFFF   "Reserved. Do not use." (Appendix D)
# $DC 0000 - $DC FFFF   the battery-backed clock, which comes on the A501 card
#                       and is not modelled
# $E0 0000 - $E7 FFFF   while the `ext` slot is empty, which is the default
# $E8 0000 - $EF FFFF   the autoconfig space proper
# $F0 0000 - $F7 FFFF   "Reserved. Do not use." (Appendix D) - and probed by
#                       Kickstart, with a word read at $F00000, while the
#                       overlay is still up
#
# An access to any of them **completes and floats**: the space's `unassigned`
# policy is `open-bus`. Appendix D marks these ranges reserved, not faulting;
# Appendix K has the bus controller drive /DTACK for a slave that does not
# answer and /BERR only for a bus collision or a DMA error; and the MC68000
# user's manual (section 5.4) leaves /BERR to external circuitry a board may
# omit. So an empty address on an A500 reads whatever the bus floats to, and a
# write to one is lost. A `fault` policy here made Kickstart's first probe of
# $F00000 a bus error whose vector was still in the ROM overlay, and the
# processor double-faulted.

machine "amiga-a500" {
  # -- how much of each memory -----------------------------------------------
  #
  # A stock A500 has 512 KiB of chip RAM; a 1 MiB Agnus takes a trapdoor
  # expansion up to 1 MiB and the second half answers at $080000. Appendix D
  # lists $00 0000-$07 FFFF and $08 0000-$0F FFFF as the two halves.
  param chip-ram = 512K

  # Kickstart 1.x is 256 KiB; 2.0 and later are 512 KiB. Both go in one socket,
  # and Gary's `_ROMEN` decodes it as a 512 KiB window, $F8 0000-$FF FFFF,
  # from A19-A23 alone (the A2000 PAL it replaced, Technical Reference Manual
  # 7.3). A 256 KiB part has no pin for A18, so it answers in both halves: at
  # $FC0000, Appendix D's "256K System ROM", and at $F80000 as well. So
  #
  #   -p kickstart-size=256K
  #
  # is the whole of the 1.x configuration; the map below and the overlay at
  # zero repeat a smaller ROM through the window (`src/dev/amiga/gary.rs`).
  param kickstart-size = 512K

  # The A501 trapdoor card's RAM at $C0 0000: `0`, a stock A500 with the
  # trapdoor empty, or `512K`. It is "slow" RAM - on the chip bus, where "the
  # processor is locked out by the custom chips" (A500/A2000 Technical
  # Reference Manual), and out of reach of every DMA pointer. With no card,
  # Gary decodes the whole of $C0 0000 - $D7 FFFF as the chip registers again,
  # every 512 bytes; with one, only the megabyte above the card. See
  # `src/dev/amiga/gary.rs` for the three documents that say so.
  param slow-ram = 0

  # Whether Paula keeps stereo output frames for a host audio sink to drain.
  # `-p audio=true` when something is listening; `--record-audio` switches it
  # on by itself. Off by default because a ring nobody reads is work for
  # nothing, and it is output rather than machine state either way.
  param audio = false

  # -- the crystal -----------------------------------------------------------
  #
  # One oscillator on the Amiga's own board, and everything on it is an exact
  # division of that one number (ROADMAP.md 4.2), which is the whole reason the
  # chipset can be dot-exact against the processor. (The keyboard and the
  # mouse, at the bottom of the file, are not on this board.) PAL:
  # 28.37516 MHz, processor at a quarter of it, 7.09379 MHz. `-p master=28636360` gives the NTSC machine and
  # a 7.15909 MHz processor, and every clock below follows it; an NTSC machine
  # also needs `standard = "ntsc"` on `agnus` and `denise`, because line counts
  # are a fact about the chips rather than about the crystal.
  param master = 28375160
  osc   clk    = master Hz

  # -- the bus ---------------------------------------------------------------
  #
  # 24 bits. A 68000 has 23 address pins and A0 is implied by the two data
  # strobes, so the chip drives a 16-megabyte space and the top byte of a
  # 32-bit address never leaves the package - which is exactly why the ROM at
  # $F80000 and the chip registers at $DFF000 are where they are. Empty
  # addresses float rather than fault: see the block above the machine.
  space mem { width = 24, endian = "big", unassigned = open-bus }

  # -- the processor ---------------------------------------------------------
  object cpu "cpu.m68k" {
    clock  = clk / 4
    space  = mem
    engine = "interp"
  }

  # -- memory ----------------------------------------------------------------
  #
  # `image` names a media slot: whoever runs the machine binds the bytes
  # (`--media kickstart=kick.rom`), and nothing below host/ opens a file. An
  # unbound slot leaves the ROM zeroed, which is a machine with an empty socket
  # - it realizes, and the processor runs whatever a page of zeroes decodes to.
  object chipram "ram" { size = chip-ram }
  object kick    "rom" { size = kickstart-size, image = "kickstart" }

  # -- the custom chips ------------------------------------------------------
  #
  # 256 word registers in 512 bytes. The object is the *decode*, not a chip:
  # Agnus, Denise and Paula subscribe to it (`custom = custom` below), and an
  # access to a chip that is not in this build falls through to the floating
  # chip data bus and is counted.
  #
  # Appendix D gives the window as $DF F000-$DF FFFF, four kilobytes, and the
  # register table fills the first 512 bytes of it. Whether the block repeats
  # through the rest is not in the manual, so this maps the 512 bytes the
  # appendix documents and leaves the rest of the window faulting.
  # `size 0x1000 = mirror(custom)` is the change if a guest turns out to need
  # it.
  object custom "amiga.custom" { }

  # -- Paula -----------------------------------------------------------------
  #
  # See `src/dev/amiga/paula.rs`. Interrupts, the disk controller, the UART and
  # the audio channels. Its clock is the colour clock, the crystal over eight -
  # 3.546895 MHz PAL - because every period the manual gives for this chip is
  # counted in it: `SERPER` "N+1 color clocks", an audio period of "124 color
  # clocks" at the least. The UART's other end is the host character port
  # `serial`; `record` is the audio ring, above.
  object paula "amiga.paula" { clock = clk / 8, custom = custom, port = "serial", record = audio }

  # -- the internal drive ----------------------------------------------------
  #
  # See `src/dev/amiga/floppy.rs`. DF0, on the colour clock like Paula because
  # the cells it hands Paula are timed in Paula's ticks. Its disk is the `df0`
  # media slot: an ADF (`--media df0=adf:disk.adf`, or out of an Amiga Forever
  # disc with `,disk=<name>`), a raw MFM dump, or `--drive df0=disk.adf` to
  # have the guest's writes go back to the file. Nothing bound is an empty
  # drive - an A500 waiting at the insert-disk screen.
  object df0 "amiga.floppy" { clock = clk / 8, paula = paula, image = "df0" }

  # -- Agnus -----------------------------------------------------------------
  #
  # See `src/dev/amiga/agnus/`. One tick of its clock is one count of the
  # horizontal beam counter: "one horizontal count takes one cycle of the
  # system clock (processor is twice this)", 3 546 895 Hz on PAL (chapter 2),
  # which is exactly the crystal over eight. It holds every DMA pointer, so it
  # names chip RAM, and it names the two chips it moves data for: Paula's disk
  # and audio slots, and the lines it pushes into Denise.
  object agnus "amiga.agnus" {
    clock    = clk / 8
    custom   = custom
    ram      = chipram
    standard = "pal"
    paula    = paula
    video    = denise
  }

  # -- Denise ----------------------------------------------------------------
  #
  # See `src/dev/amiga/denise.rs`. It counts no beam and reads no memory: Agnus
  # drives it a line at a time. Its clock is its 7M pin, the crystal over four,
  # which is what a host scans the picture out against.
  object denise "amiga.denise" { custom = custom, clock = clk / 4 }

  # -- the overlay -----------------------------------------------------------
  #
  # See `src/dev/amiga/gary.rs`. At reset `OVL` is asserted and the window at
  # zero decodes to the ROM, which is how the processor finds a reset vector in
  # a machine whose RAM holds nothing; CIA-A's PA0 clears it and chip RAM takes
  # over the same addresses, where the exception vector table then lives.
  #
  # It names its two sources as *objects*, not addresses, because chip RAM's
  # only address on this machine is zero and so is the decoder's own - there
  # would be nothing to look up.
  #
  # Gary also decodes bank 6, $C0 0000 - $D7 FFFF: the trapdoor card's RAM
  # when `slow-ram` fits one, and `custom`'s registers repeating everywhere
  # else. The card's RAM is Gary's own rather than a `ram` object, because a
  # stock board has none and an object cannot have no bytes.
  #
  # And a window at $E0 0000 for an extended ROM. **A real A500 has no such
  # socket.** It exists to run AROS, whose ROM is two 512 KiB halves and whose
  # second half - with the graphics library in it - is built to answer at
  # $E0 0000. `ext` names the media slot (`--media ext=aros-ext.rom`), and the
  # front ends bind it to no bytes when nobody names one. No bytes is no
  # socket: the range floats exactly as it did before the window existed.
  object gary "amiga.gary" {
    space    = mem
    rom      = kick
    ram      = chipram
    size     = chip-ram
    custom   = custom
    slow-ram = slow-ram
    ext      = "ext"
  }

  # -- the two 8520s ---------------------------------------------------------
  #
  # See the comment block at the top. `cia_a_decode` and `cia_b_decode` are the
  # board's half of each chip: register select on A8-A11 and one byte lane.
  object cia_a "mos.8520" { clock = clk / 40 }
  object cia_b "mos.8520" { clock = clk / 40 }

  object cia_a_decode "amiga.cia-decode" { chip = cia_a, lane = "odd"  }
  object cia_b_decode "amiga.cia-decode" { chip = cia_b, lane = "even" }

  # -- the memory map --------------------------------------------------------
  #
  # Chip RAM is *not* mapped directly. It is reached through `gary.overlay`,
  # which decides per access whether the ROM or the RAM answers at the low
  # addresses - one decoder in front of both, rather than two mappings that
  # would have to be swapped from inside a CIA write.
  map mem 0x000000 size chip-ram       = gary.overlay { endian = "big" }
  map mem 0xDFF000 size 0x200          = custom
  map mem 0xF80000 size 512K           = mirror(kick) { endian = "big" }
  map mem 0xBFE000 size 0x1000         = cia_a_decode { endian = "big" }
  map mem 0xBFD000 size 0x1000         = cia_b_decode { endian = "big" }
  # Big-endian by their own declaration, with no `endian` here: the card's
  # RAM, the register decode and the extended ROM each say so on the region,
  # because bank 6 (and an empty `ext`) is a container, and a container's byte
  # order is its leaves'.
  map mem 0xC00000 size 0x180000       = gary.bank6
  map mem 0xE00000 size 512K           = gary.ext

  # -- wiring ----------------------------------------------------------------
  #
  # "PA0..OVL  ROM/RAM overlay bit" (Appendix E, port signal assignments).
  # Active high: the same table stars `RDY*`, `TK0*`, `WPRO*`, `CHNG*` and
  # `LED*` beside it and does not star `OVL`. Out of reset the CIA's port A is
  # all inputs, so the pin shows the chip's pull-up and the ROM is at zero;
  # software clears the overlay by making PA0 an output and writing a zero.
  wire cia_a.pa0 -> gary.ovl

  # Interrupts. "The various kinds of interrupts generated by the hardware are
  # brought into the peripherals chip and are translated into six of the seven
  # available interrupts of the 680x0" (chapter 7, "Interrupts"): Paula drives
  # the processor's three IPL pins with an encoded level, and nothing else in
  # the machine touches them.
  wire paula.ipl0 -> cpu.ipl0
  wire paula.ipl1 -> cpu.ipl1
  wire paula.ipl2 -> cpu.ipl2

  # "CIAA can generate interrupt INT2", "CIAB can generate INT6" (Appendix F),
  # and INT2* sets PORTS, level 2, while INT6* sets EXTER, level 6 (chapter 7;
  # figure 7-4 lists "external INT2 & CIAA" and "external INT6 & CIAB"). The
  # expansion bus shares both lines; nothing is plugged into it.
  wire cia_a.irq -> paula.int2
  wire cia_b.irq -> paula.int6

  # The floppy lines (chapter 8, Table 8-5; Appendix E). CIA-B's port B is
  # eight outputs to the drives, and CIA-A's PA2-PA5 four inputs from them. The
  # drive's outputs are open-collector, so each net carries the pull-up the CIA
  # pins have, and a deselected drive lets go. Only DF0 is fitted: SEL1*-SEL3*
  # on PB4-PB6 go to the external connector, where nothing is plugged in.
  wire cia_b.pb7 -> df0.mtr   { pull = "up" }    # MTR*   motor
  wire cia_b.pb3 -> df0.sel   { pull = "up" }    # SEL0*  select the internal drive
  wire cia_b.pb2 -> df0.side  { pull = "up" }    # SIDE*  low: side 1
  wire cia_b.pb1 -> df0.dir   { pull = "up" }    # DIR    low: towards the centre
  wire cia_b.pb0 -> df0.step  { pull = "up" }    # STEP*
  wire df0.rdy   -> cia_a.pa5 { pull = "up" }    # RDY*
  wire df0.tk0   -> cia_a.pa4 { pull = "up" }    # TK0*
  wire df0.wpro  -> cia_a.pa3 { pull = "up" }    # WPRO*
  wire df0.chng  -> cia_a.pa2 { pull = "up" }    # CHNG*
  # "Disk index pulse ($BFDD00, bit 4)": CIA-B's /FLAG, whose falling edge sets
  # ICR bit 4 and can raise level 6.
  wire df0.index -> cia_b.flag { pull = "up" }   # INDEX*

  # Video timing into the CIAs' time-of-day counters (Appendix F: CIA-A's TOD
  # is "VSync or line tick", CIA-B's horizontal sync). Each counts rising
  # edges; Agnus raises `vsync` at line 0 and `hsync` at count 0 of each line.
  wire agnus.vsync -> cia_a.tod
  wire agnus.hsync -> cia_b.tod

  # -- the keyboard and the mouse --------------------------------------------
  #
  # Both are their own hardware at the end of a cable, and both are timed in
  # microseconds: the keyboard's protocol is written that way (Appendix G:
  # "about 20 microseconds", "143 ms"), and the mouse spreads a host's motion
  # over time at a rate a real mouse reaches. So they share a microsecond clock
  # of their own rather than a division of the Amiga's crystal, which the
  # keyboard's own microcontroller never saw. It is a second oscillator tree;
  # the scheduler converts between the two in fixed point.
  osc periph = 1000000 Hz

  # See `src/dev/amiga/keyboard.rs`. What a person types arrives as raw
  # keycodes on the host keyboard port `keyboard`, through the record/replay
  # seam, and leaves as Appendix G's protocol.
  object kbd "amiga.keyboard" { clock = periph }

  # "The keyboard data line is connected to the SP pin, the keyboard clock is
  # connected to the CNT pin" (chapter 8); Appendix E: "SP...KDAT",
  # "CNT..KCLK". KCLK is the keyboard's alone. KDAT is driven by both ends,
  # open-collector with pull-ups at each (Appendix G), so it is two statements
  # and one net: the keyboard pulls it low for a one, and the CIA pulls it low
  # for the handshake by turning its serial port to output.
  wire kbd.kclk  -> cia_a.cnt { pull = "up" }
  wire cia_a.sp  -> kbd.kdat  { pull = "up" }
  wire kbd.kdat  -> cia_a.sp

  # See `src/dev/amiga/mouse.rs`. In game port 0, where the manual puts a mouse,
  # moved through the host mouse port `mouse`. Its wheels are four
  # open-collector quadrature lines into Denise's mouse counters (Appendix A,
  # JOY0DAT: pin 1 Y, pin 3 YQ on M0V; pin 2 X, pin 4 XQ on M0H). The left
  # button is "PA6..game port 0, pin 6 (fire button*)" (Appendix E); the right
  # button is pin 9 and the middle pin 5 (chapter 8, "Mouse Buttons"), which are
  # POTGO's DATLY and DATLX on Paula (Table 8-4).
  object mouse "amiga.mouse" { clock = periph }

  wire mouse.y      -> denise.m0v  { pull = "up" }
  wire mouse.yq     -> denise.m0vq { pull = "up" }
  wire mouse.x      -> denise.m0h  { pull = "up" }
  wire mouse.xq     -> denise.m0hq { pull = "up" }
  wire mouse.left   -> cia_a.pa6   { pull = "up" }
  wire mouse.right  -> paula.potly { pull = "up" }
  wire mouse.middle -> paula.potlx { pull = "up" }
}
