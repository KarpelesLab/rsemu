# tft-spi — the smallest board an ST7789 driver can run against.
#
#   rsemu run tft-spi
#
# An SPI controller and a **Sitronix ST7789** on the far end of it, and nothing
# else. The colour twin of `oled-spi`, and the same shape for the same reasons:
# it models no product, it has **no processor** — every register is reached
# through an address space and a test drives those directly, which is how a
# driver reaches them anyway — and a failure on a board with three objects on it
# is a failure in the device rather than a bisection. `nvme-mini` argues the
# same case at more length.
#
# ---------------------------------------------------------------------------
# Why a separate board rather than a second panel on `oled-spi`
# ---------------------------------------------------------------------------
#
# Because `host::display::panel`'s capture table hands a host *the* panel, and a
# board with two of them would make "the picture" a question with two answers.
# The two parts also want different SPI word widths, and `CTRL`'s width field is
# per-controller rather than per-chip-select. Two boards is the honest shape.
#
# ---------------------------------------------------------------------------
# `interface = "spi3"`, and the 240x240 module
# ---------------------------------------------------------------------------
#
# The ST7789's 4-line framing needs a `D/CX` output, and there is no
# general-purpose output block in this tree for one to hang off. Its 3-line
# framing (§9.1's `SPI_3W`) puts `D/CX` in the first of nine bits instead, and
# rsemu's SPI controller takes word widths from 1 to 32, so nine costs nothing.
# `interface = "spi4"` is modelled and tested — `src/dev/sitronix/st77xx.rs`
# drives the pin as an ordinary `WireSink` — it simply has no board yet.
#
# The glass is 240x240 while frame memory is 240x320, which is the geometry of
# the commonest 1.3" module and the one whose `MADCTL MY` trap
# `a_240x240_module_shows_rows_0_to_239_or_80_to_319_per_madctl_my` is about:
# the 240 gate lines that exist cover memory rows 0..239 with `MY` clear and
# rows 80..319 with it set, which is why every driver adds 80 to its row address
# when it rotates by 180 degrees.

machine "tft-spi" {
  # Which modelling style the SPI link uses — `docs/buses/low-speed.md` asks
  # that this be written down rather than inherited.
  param link = "wired"

  # Which named SPI bus the controller and the panel meet on.
  param spibus = "tft0"

  # Which member of the family: `st7789`/`st7789v` (240x320 of frame memory) or
  # `st7735`/`st7735s` (132x162).
  param part = "st7789"

  # The visible glass, and where it sits in frame memory. A full 2.0" ST7789 is
  # 240x320 at 0,0; a 1.3" one is 240x240 at 0,0; a 128x160 ST7735 module is at
  # 2,1.
  param width  = 240
  param height = 240
  param col    = 0
  param row    = 0

  # -- the crystal -----------------------------------------------------------
  #
  # One oscillator, so every ratio on this board is exact (ROADMAP.md §4.2).
  # The panel does not use it and has no clock domain: its refresh is internal,
  # unobservable and therefore unmodelled, which `src/dev/lcd/panel.rs` argues.
  osc sysclk = 48000000 Hz

  # -- the bus ---------------------------------------------------------------
  space mem { width = 32 }

  # -- the SPI controller ----------------------------------------------------
  object spi "spi.controller" {
    clock        = sysclk
    link         = link
    bus          = spibus
    chip-selects = 1
  }

  # -- the panel -------------------------------------------------------------
  object tft "sitronix.st77xx" {
    variant    = part
    interface  = "spi3"
    width      = width
    height     = height
    col-offset = col
    row-offset = row
    bus        = spibus
    cs         = 0
  }

  # -- the memory map --------------------------------------------------------
  map mem 0x40000000 size 4K = mirror(spi)   # 6 registers, 170 times over

  # -- the SPI wires ---------------------------------------------------------
  #
  # Used when `link = "wired"`, idle otherwise. `SDA` is one bidirectional pin
  # on the real part — which is what makes `RDDID` and `RAMRD` work on a 3-line
  # bus — and is split into `mosi` and `miso` here because an rsemu wire has
  # fixed drivers and cannot be tri-stated. A 3-line controller ties the two
  # together outside the chip.
  wire spi.sck  -> tft.sck
  wire spi.mosi -> tft.mosi
  wire spi.cs0  -> tft.cs
  wire tft.miso -> spi.miso

  # Not wired, and deliberately: the panel's `res` pin. This board ties RESX
  # high through a pull-up, which is what an unwired reset input already means
  # here (see `src/dev/sitronix/st77xx.rs`).
}
