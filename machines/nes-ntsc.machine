# The NTSC Nintendo Entertainment System / Famicom.
#
#   rsemu run nes-ntsc --cart smb.nes
#
# Sources: NESdev wiki, "Cycle reference chart" (master clock and the divisors),
# "CPU memory map" and "PPU memory map" (the decoding below), "NROM".
#
# The PPU and the APU are here, mapped and wired. Both are *lazily advanced*
# (ROADMAP.md §4.2): they hold their own tick and are caught up before any
# access is dispatched to them. The PPU goes further and asks to be caught up on
# every CPU cycle, because it drives /NMI and the core looks at that pin once a
# cycle — three dots to a cycle, and which of them the pin moved on is a
# question software can ask.
#
# So are the DMA unit, the controller port and cartridge-driven nametable
# mirroring. The DMA unit drives /RDY, so a sprite copy or a DMC sample fetch
# really does halt the CPU and take the bus a cycle at a time.

machine "nes-ntsc" {
  # One crystal, so every domain below is exactly related to every other: the
  # PPU advances exactly three dots per CPU cycle, forever, with no rounding.
  # 236250000/11 Hz is 21477272.72… — it is genuinely not an integer number of
  # hertz, which is why the literal is rational. That inexactness affects the
  # wall-clock rate and nothing else; the CPU:PPU ratio stays 1:3 exactly
  # (ROADMAP.md §4.2).
  osc master = 236250000/11 Hz

  # The 6502 drives 16 address lines; the PPU decodes 14 and mirrors the rest.
  # Neither bus has a bus-error line: an address nobody answers leaves the last
  # value on the wire, and software depends on that (NESdev, "Open bus").
  space cpubus { width = 16, unassigned = open-bus }
  space ppubus { width = 14, unassigned = open-bus }

  # 2 KiB on the console's board. Two more address lines than it needs are
  # decoded, so it answers four times over $0000-$1FFF.
  object wram "ram" { size = 2K }

  object cpu "cpu.mos6502" {
    clock  = master / 12
    space  = cpubus
    engine = "interp"
    # The DMA unit drives /RDY: a sprite copy or a DMC sample fetch halts this
    # core mid-instruction and takes the bus for a cycle at a time.
    rdy    = dma
    # The Ricoh RP2A03 is a 6502 with the BCD adder removed. The D flag still
    # exists and SED/CLD/PHP still see it; ADC and SBC ignore it.
    decimal = false
  }

  # Master ÷ 4 is the dot clock, which is master ÷ 12 ÷ 3 — the exact 3:1 the
  # whole oscillator forest exists to preserve. `space = ppubus` is what the
  # chip fetches patterns and nametables through; it is a bus master, not just
  # a responder.
  object ppu "nes.ppu" { clock = master / 4, space = ppubus, region = "ntsc" }

  # The audio half of the RP2A03: the same die as the CPU, so the same domain.
  object apu "nes.apu" { clock = master / 12, region = "ntsc" }

  # The cartridge. `rom` names a media slot rather than a file: the machine
  # description says which slot, and whoever runs the machine binds the bytes
  # (`--cart smb.nes`). Nothing below host/ opens a file.
  object cart "nes.nrom" { rom = "cart" }

  # The two controller ports. `pads` names the host seam buttons arrive
  # through (src/dev/nes/input.rs); the default is what a front end opens.
  # The ports take the CPU's clock, and not because anything in them advances
  # on its own: the console drives the controllers' latch line only on "put"
  # cycles, so whether a one-cycle strobe pulse ever reaches the pads depends on
  # which half of an APU cycle the write landed on.
  object ports "nes.ports" { clock = master / 12, pads = "nes-pads" }

  # The RP2A03's DMA unit — both of them, because the die has one arbiter. A
  # write to $4014 copies 256 bytes into OAM through $2004; the DMC's sample
  # fetch shares the same /RDY line, the same get/put cadence and the same
  # precedence rule, so it is declared here rather than modelled twice.
  object dma "nes.oamdma" { space = cpubus, dmc = apu }

  # -- the CPU bus -----------------------------------------------------------
  map cpubus 0x0000 size 0x2000 = mirror(wram)   # 2K, mirrored 4x
  map cpubus 0x2000 size 0x2000 = ppu.regs       # 8 registers, mirrored x1024
  map cpubus 0x4000 size 0x0014 = apu.channels   # $4000-$4013
  map cpubus 0x4014 size 0x0001 = dma.port       # OAM DMA, not an APU register
  map cpubus 0x4015 size 0x0001 = apu.status
  map cpubus 0x4016 size 0x0001 = ports.port1    # controller 1
  # $4017 is two registers on one address: the APU frame counter on a write and
  # controller 2 on a read. A mapping routes both halves of an access to one
  # device, so this is a choice, and the frame counter wins — its IRQ drives
  # game logic, where a missing player two loses only player two. `ports.port2`
  # exists for a machine that would rather have it the other way.
  map cpubus 0x4017 size 0x0001 = apu.frame
  map cpubus 0x8000 size 0x8000 = cart.prg       # NROM-128 repeats itself here

  # -- the PPU bus -----------------------------------------------------------
  map ppubus 0x0000 size 0x2000 = cart.chr        # the two pattern tables
  # The nametables come from the *cartridge*, which is where the arrangement is
  # decided: `nes.nrom` reads it out of the iNES header and publishes four 1 KiB
  # windows onto the console's CIRAM already wired that way. A machine file that
  # spelled the mirroring itself would be wrong for half the library.
  map ppubus 0x2000 size 0x1000 = cart.nametables
  map ppubus 0x3000 size 0x0f00 = cart.nametables # and their $3000 mirror

  # -- interrupts ------------------------------------------------------------
  # Driven high when requested, not low: nets idle low and inverting the
  # active-low /NMI pin would be a `wire.not` device's job (ROADMAP.md §4.3).
  wire ppu.nmi -> cpu.nmi
  # Wired-OR with the cartridge's IRQ when a mapper that has one turns up; the
  # net carries per-source levels for exactly that reason.
  wire apu.irq -> cpu.irq

}
