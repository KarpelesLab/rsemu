# The NTSC Nintendo Entertainment System / Famicom.
#
#   rsemu run nes-ntsc --cart smb.nes
#
# Sources: NESdev wiki, "Cycle reference chart" (master clock and the divisors),
# "CPU memory map" and "PPU memory map" (the decoding below), "NROM".
#
# INCOMPLETE. The PPU and APU objects are not here yet — see the TODO at the
# bottom — so $2000-$401F is unassigned and reads as open bus. A cartridge
# boots, fetches its reset vector and executes; a game does not yet display.

machine "nes-ntsc" {
  # One crystal, so every domain below is exactly related to every other: the
  # PPU advances exactly three dots per CPU cycle, forever, with no rounding.
  # 236250000/11 Hz is 21477272.72… — it is genuinely not an integer number of
  # hertz, which is why the literal is rational. That inexactness affects the
  # wall-clock rate and nothing else; the CPU:PPU ratio stays 1:3 exactly
  # (ROADMAP.md §4.2).
  osc master = 236250000/11 Hz

  # The 6502 drives 16 address lines; the PPU decodes 14 and mirrors the rest.
  # Neither bus has a bus-error line: an address nobody answers leaves the last
  # value on the wire, and software depends on that (NESdev, "Open bus").
  space cpubus { width = 16, unassigned = open-bus }
  space ppubus { width = 14, unassigned = open-bus }

  # 2 KiB on the console's board. Two more address lines than it needs are
  # decoded, so it answers four times over $0000-$1FFF.
  object wram "ram" { size = 2K }

  object cpu "cpu.mos6502" {
    clock  = master / 12
    space  = cpubus
    engine = "interp"
    # The Ricoh RP2A03 is a 6502 with the BCD adder removed. The D flag still
    # exists and SED/CLD/PHP still see it; ADC and SBC ignore it.
    decimal = false
  }

  # The cartridge. `rom` names a media slot rather than a file: the machine
  # description says which slot, and whoever runs the machine binds the bytes
  # (`--cart smb.nes`). Nothing below host/ opens a file.
  object cart "nes.nrom" { rom = "cart" }

  # -- the CPU bus -----------------------------------------------------------
  map cpubus 0x0000 size 0x2000 = mirror(wram)   # 2K, mirrored 4x
  map cpubus 0x8000 size 0x8000 = cart.prg       # NROM-128 repeats itself here

  # -- the PPU bus -----------------------------------------------------------
  map ppubus 0x0000 size 0x2000 = cart.chr       # the two pattern tables

  # TODO(ppu, apu): the block below is what this file is still missing. Both
  # classes exist and both publish regions and pins — `rsemu describe nes.ppu`
  # will show you — so this is written against their real surface and is meant
  # to be uncommented rather than rewritten.
  #
  #   object ppu "nes.ppu" { clock = master / 4, space = ppubus, region = "ntsc" }
  #   object apu "nes.apu" { clock = master / 12, region = "ntsc" }
  #
  #   map cpubus 0x2000 size 0x2000 = ppu.regs      # 8 registers, mirrored x1024
  #   map cpubus 0x4000 size 0x0014 = apu.channels  # $4000-$4013
  #   map cpubus 0x4015 size 0x0001 = apu.status    # $4014 is OAM DMA, not the APU's
  #   map cpubus 0x4017 size 0x0001 = apu.frame     # $4016 is the controller port
  #
  #   wire ppu.nmi  -> cpu.nmi
  #   wire apu.irq  -> cpu.irq                      # wired-OR with the cartridge's
  #
  # What blocks it: the PPU and the APU are lazily advanced — they hold their
  # own tick and are caught up by whoever reads them (ROADMAP.md §4.2) — and no
  # class can yet *declare* that to the realizer, so a mapped PPU would never
  # advance and $2002 would report VBlank clear forever. That is a worse machine
  # than this one, where the open bus at least reads as ones. See
  # `machine::catalog::bindings`.
  #
  # Two more devices do not exist at all yet: OAM DMA at $4014 (a CPU-side
  # stall, not a PPU register) and the controller ports at $4016/$4017.
  #
  # Nametables are the cartridge's to publish, not this file's: which 1 KiB of
  # CIRAM answers where is decided by how the board ties CIRAM A10, and that is
  # a property of the cartridge in the slot rather than of the console. The
  # console owns the 2 KiB, though, so the two have to meet somewhere the DSL
  # can express — an unsolved piece of `nes.nrom`.
}
