# alphard-navi - the Aisin navigation computer in a Toyota Alphard (GGH30).
#
#   rsemu run alphard-navi --media flash=S29JL064J.bin
#
# The head unit (Toyota 86100-58182, Panasonic CQ-UT24J0AJ) carries an Aisin AW
# computer board, 99370-00649, built around a Renesas R-Car Gen1 SoC (marked
# R8A77791): Cortex-A9 MPCore, 1 GiB of DDR3 on two channels, and an 8 MiB
# Spansion S29JL064J NOR flash on the local bus at address zero. The flash holds
# U-Boot 2011.03, a Linux 2.6.35 uImage and a CramFS "recovery" root whose job is
# to load the full system from the map SD card and warm-reboot into it.
#
# Everything below that is not a datasheet fact was learnt by running that
# flash image and watching what it touched (docs/platforms/alphard-navi.md) --
# the memory map, the interrupt numbers, the clock rate the kernel assumes. No
# Linux or U-Boot *source* was read; the SoC's hardware manual is not public.
#
# ---------------------------------------------------------------------------
# What is modelled, and what is a placeholder
# ---------------------------------------------------------------------------
#
# Modelled: the core (ARMv7-A, VFPv3, the A9's CP15 and MMU), the MPCore private
# region (SCU, timers, GIC), the L2C-310, the NOR flash with the AMD command set,
# on-chip SRAM, DRAM, the three TMU timer units, the SCIF the kernel names, and
# the Display Unit.
#
# Placeholders: every other register block the firmware touches is a plain
# `ram` object -- storage that reads back what was written, and nothing else.
# That is exactly the arm926 skeleton's idiom, and it is labelled at each map
# line. It is enough for the boot code's write-then-read-back sequences; it is
# *not* a model, and anything that waits for a status bit to change there waits
# forever or times out. A placeholder that becomes a device is a one-line map
# change.

machine "alphard-navi" {
  # -- clocks ----------------------------------------------------------------
  #
  # The core runs at 800 MHz here; the part is rated for 1 GHz and the real
  # rate is set by the CPG, which is not modelled. What matters to the guest is
  # the peripheral clock the kernel *believes* in: it programs TMU0 for a 1 ms
  # tick with TCOR = 0x3ae0 at Pφ/4, which is 60.288 MHz. The dot clock gives
  # the 1176 x 525 raster rcarfb programs exactly 60 frames a second.
  param cpu-hz = 800000000
  osc cpuclk = cpu-hz Hz
  osc pclk   = 60288000 Hz
  osc dotclk = 37044000 Hz

  space mem { width = 32 }

  # -- the core --------------------------------------------------------------
  #
  # One Cortex-A9. The SoC has more, but the kernel on this flash counts one
  # ("Brought up 1 CPUs") from the SCU below, and a second core is a change to
  # `cpus` here and in the SCU and GIC once secondary bring-up is understood.
  object cpu "cpu.arm" {
    clock      = cpuclk
    space      = mem
    cpu        = "cortex-a9"
    periphbase = 0xf0000000
  }

  # -- memory ----------------------------------------------------------------

  # IC400: S29JL064J, 8 MiB, x16 on the local bus, boot sectors at both ends.
  # The kernel's physmap driver finds it through CFI and splits it into four
  # partitions.
  object nor "flash.cfi" {
    size = 8M, width = 2, interleave = 1, command-set = "amd"
    blocks = [8, 8K, 126, 64K, 8, 8K]
    device = 0x227e, device-ext = [0x2202, 0x2201]
    banks = [23, 48, 48, 23], boot-flag = 1
    image = "flash"
  }

  # On-chip SRAM: U-Boot copies its DDR initialisation here and runs it before
  # DRAM exists, and the kernel keeps its warm-reboot flag at 0xfe794000. The
  # 12 KiB below it, at 0xfe780000, are interrupt-controller registers, not
  # memory: the kernel maps exactly that window for them.
  object sram "ram" { size = 64K }

  # Two DDR3 channels, contiguous from 0x60000000. The kernel is told
  # mem=256M at 0x80000000; U-Boot relocates itself to the top of the second
  # channel.
  object dram "ram" { size = 1G }

  # -- the Cortex-A9 MPCore private region -----------------------------------
  object mpcore "arm.a9mpcore" { clock = cpuclk / 2, cpus = 1 }
  object gic    "arm.gic"      { version = 1, cpus = 1, spis = 288 }
  object l2     "arm.l2c310"   { size = 1M, ways = 16 }

  # -- SoC peripherals ---------------------------------------------------------

  # TMU0: channel 0 is the kernel's 1 ms tick (GIC ID 64), channel 1 its free-
  # running clocksource. TMU1 channel 0 is a 20 ms timer on ID 68. TMU2 is
  # mapped because the kernel's static I/O table maps it.
  object tmu0 "rcar.tmu" { clock = pclk }
  object tmu1 "rcar.tmu" { clock = pclk }
  object tmu2 "rcar.tmu" { clock = pclk }

  # SCIF0, where console=ttyS0 would go if this kernel had a console driver.
  # It does not: the production kernel's printk is a stub and the only SCIF
  # user is Aisin's DMA-driven link to the sub-processors. Mapped so that
  # anything written there is visible on the `console` port.
  object scif0 "rcar.scif" { clock = pclk / 1024, port = "console" }

  # The HPB-DMAC: the peripherals' DMA controller. The SCIFs and SD hosts move
  # their data through it. Its channels reach the GIC through twelve group
  # lines, IDs 142-153, with a status mirror at 0xfe782000 the kernel reads to
  # tell the channels of a group apart (it numbers them 260 + n).
  object hpbdmac "rcar.hpbdmac" { clock = pclk / 1024, space = mem }

  # SCIF1-5: the links to the sub-processors, driven by Aisin's scif_iif and
  # its clients. SCIF3 is the PSC link to the base board's MN103 (power supply
  # control, which switches the SD slot among much else), by DMA on channels
  # 6 (transmit) and 7 (receive). SCIF n interrupts on GIC ID 120 + n.
  object scif1 "rcar.scif" { clock = pclk / 1024, port = "scif1" }
  object scif2 "rcar.scif" { clock = pclk / 1024, port = "scif2" }
  object scif3 "rcar.scif" { clock = pclk / 1024, link = "psc", side = "a", dma = true }

  # The base board's MCU on the other end of SCIF3, as its PSC protocol peer.
  # One line per command it answers goes to the `psc` port.
  # The HSPI: three SPI masters by programmed I/O, inside the pin
  # controller's page. The driver's channel numbers are not address order:
  # its channel 0 is at 0xfffc7000 (the DC-DC/ADC monitor), 1 at 0xfffc8000
  # and 2 at 0xfffc6000 (the two CIS links to the base-board sub-CPUs).
  object hspi0 "rcar.hspi" { bus = "hspi0" }
  object hspi1 "rcar.hspi" { bus = "hspi1" }
  object hspi2 "rcar.hspi" { bus = "hspi2" }

  # -- I2C -------------------------------------------------------------------
  #
  # Three controllers. Which part sits on which bus is the kernel's own
  # i2cfs table (33 entries, the one every transfer goes through), not its
  # board-info table, which lists the same parts on bus 0 and generates no
  # traffic. Every part is an `i2c.regfile` stand-in for now: it answers its
  # addresses and reads back what was written. The ADV7186s answer their ten
  # sub-map addresses each from the start.
  object i2c0 "rcar.i2c" { bus = "i2c0" }
  object i2c1 "rcar.i2c" { bus = "i2c1" }
  object i2c2 "rcar.i2c" { bus = "i2c2" }
  object mfi     "i2c.regfile" { bus = "i2c0", addresses = "0x10" }   # Apple MFi auth coprocessor
  object ak7734  "i2c.regfile" { bus = "i2c1", addresses = "0x18" }   # AKM audio DSP
  object adv_fse "i2c.regfile" { bus = "i2c1", addresses = "0x60, 0x48, 0x26, 0x50, 0x52, 0x70, 0x54, 0x4a, 0x42, 0x22, 0x24" }
  object adv_rse "i2c.regfile" { bus = "i2c1", addresses = "0x61, 0x49, 0x2a, 0x29, 0x28, 0x71, 0x55, 0x4b, 0x43, 0x30, 0x25" }
  object gvif    "i2c.regfile" { bus = "i2c1", addresses = "0x27" }   # CXD4905 GVIF
  object rcam    "i2c.regfile" { bus = "i2c1", addresses = "0x20" }   # ADV7180 rear camera decoder
  object usbhub  "i2c.regfile" { bus = "i2c1", addresses = "0x2c" }
  object rtc     "i2c.regfile" { bus = "i2c2", addresses = "0x51" }   # RA-8581SA
  object tpnl    "i2c.regfile" { bus = "i2c2", addresses = "0x5c" }   # touch panel
  object e2prom  "i2c.regfile" { bus = "i2c2", addresses = "0x54, 0x55, 0x56, 0x57" }

  # -- kernel logs (a debugging aid, not part of the board) ------------------
  #
  # Both kernels are built with printk reduced to a stub and no console, so the
  # unit prints nothing anywhere. These taps put printk back (it calls the
  # intact vprintk through a trampoline written into sys_swapon, which a unit
  # without swap never runs) and copy each kernel's log ring to the `klog`
  # port, along with whatever processes write to stdout and stderr (`{1}...`,
  # `{2}...`: the system-call table's write entry goes through a hook too): `rsemu run alphard-navi ... --console klog`. They change the guest;
  # delete them for an untouched run. Every address is the kernel image's own,
  # off its symbol table: the flash kernel is mapped one to one, the SD card's
  # runs its text at 0x7f080000 from 0x62f80000 and its data at 0x80000000 from
  # 0x62e00000, and is patched only once it is running and its log index has
  # moved -- U-Boot hashes the image before it jumps.
  object klog_flash "linux.printk" {
    space = mem, port = "klog", clock = wdclk,
    stub = 0x8020c5b4, vprintk = 0x8003d0cc, tramp = 0x80091500,
    log-buf = 0x80307400, log-end = 0x803073e4,
    write-syscall = 0x800222d4, sys-write = 0x80099da4,
  }
  object klog_sd "linux.printk" {
    space = mem, port = "klog", clock = wdclk,
    stub = 0x6325e838, stub-va = 0x7f35e838, vprintk = 0x7f0b7cdc,
    tramp = 0x6300d500, tramp-va = 0x7f10d500,
    log-buf = 0x62e5e180, log-end = 0x62e5e164,
    ready = 0x62e5e164,
    write-syscall = 0x62f9c3d4, sys-write = 0x7f11b95c,
  }

  object psc "navi.psc" { clock = wdclk, link = "psc", side = "b", log = "psc" }
  object scif4 "rcar.scif" { clock = pclk / 1024, port = "scif4" }
  object scif5 "rcar.scif" { clock = pclk / 1024, port = "scif5" }

  # GPIO banks 0-6. Their interrupts are GIC IDs 173-179, one per bank, which
  # the kernel's GPIO driver chains to. Pins nothing drives read high: the
  # sub-processor handshake lines are active-low with pull-ups, and a line that
  # read low would be a request nobody made.
  object gpio0 "rcar.gpio" { inputs = 0xffffffff }
  object gpio1 "rcar.gpio" { inputs = 0xffffffff }
  object gpio2 "rcar.gpio" { inputs = 0xffffffff }
  object gpio3 "rcar.gpio" { inputs = 0xffffffff }
  object gpio4 "rcar.gpio" { inputs = 0xffffffff }
  object gpio5 "rcar.gpio" { inputs = 0xffffffff }
  object gpio6 "rcar.gpio" { inputs = 0xffffffff }

  # The sub-processor's watchdog. The kernel toggles GPIO 4.28 every few tens
  # of milliseconds (U-Boot does too, in its loops), and its restart path --
  # after leaving a boot flag in SRAM -- stops toggling and spins. What pulls
  # the SoC's reset then is the sub-processor, not modelled beyond this:
  # silence on the pin for `timeout` milliseconds. The real timeout is not
  # known; two seconds is well clear of the kernel's kick period. It resets
  # the whole SoC, warm -- every peripheral, not just the core -- and DRAM and
  # SRAM keep their contents, which is what the warm reboot into a kernel
  # loaded from the SD card depends on.
  osc wdclk = 1000 Hz
  object subwdt "watchdog.pin" { clock = wdclk, timeout = 2000, scope = "machine" }

  # The four SD host interfaces. The kernel's own resource tables give their
  # interrupts: SDHI0 is GIC ID 136, SDHI3 138, SDHI2 139 (SDHI1 is not used).
  # Each drives a socket by name; the map card is in the one `map-slot` names.
  object sdhi0 "rcar.sdhi" { slot = "sd0" }
  object sdhi1 "rcar.sdhi" { slot = "sd1" }
  object sdhi2 "rcar.sdhi" { slot = "sd2" }
  object sdhi3 "rcar.sdhi" { slot = "sd3" }

  # The map card: whatever the run supplies with `--drive sd=card.img`, and an
  # empty socket when it supplies nothing -- the unit's "no SD" case.
  param map-slot = "sd3"
  # A genuine map card arrives password locked and the unit unlocks it with
  # CMD42 before reading it. The password is not written here: pass it with
  # `-p map-password=...` to run a card as the unit meets it. Empty (the
  # default) is an unlocked card, which the unit also reads.
  param map-password = ""
  object mapcard "sd.card" { drive = "sd", slot = map-slot, password = map-password }

  # The Display Unit: rcarfb drives plane 1 as 800x480 RGB565 from 0x9e000000.
  object du "rcar.du" { clock = dotclk, space = mem }

  # -- placeholders: storage, not models (see the header) ---------------------
  object extcs  "ram" { size = 4K }    # 0x18100000: a device on an LBSC chip select U-Boot probes
  object intc   "ram" { size = 4K }    # 0xfe700000: interrupt mask registers
  object intcs  "ram" { size = 8K }    # 0xfe780000: the interrupt controller's configuration
  object dbsc0  "ram" { size = 4K }    # 0xfe800000: DDR controller, channel 0
  object dbsc1  "ram" { size = 4K }    # 0xfec00000: DDR controller, channel 1
  object lbsc   "ram" { size = 4K }    # 0xff800000: local bus state controller
  object misc0  "ram" { size = 32K }   # 0xffc00000: 0xffc00300/400 (DMA request routing, among others)
  object darc   "ram" { size = 4K }    # 0xffc55000: the kernel's UIO_DARC block
  object cpg    "ram" { size = 4K }    # 0xffc80000: clock pulse generator
  object sysc   "ram" { size = 4K }    # 0xffcc0000: power control (the SGX power-up poll times out here)
  object dma    "ram" { size = 4K }    # 0xffd85000: DMA controller registers
  object misc1  "ram" { size = 4K }    # 0xfff12000
  object audio0 "ram" { size = 4K }    # 0xffd8a000: audio, touched by the SD kernel's route_pdc_setReg
  object audio1 "ram" { size = 8K }    # 0xffd90000: audio routing and serial sound ports (route_pdc_setReg)
  object misc2  "ram" { size = 4K }    # 0xffe49000: read once by route_pdc_setReg
  object usbh   "ram" { size = 4K }    # 0xffe70000: USB host bridge (the SD kernel's rcar_usbh_init)
  object adg    "ram" { size = 4K }    # 0xfffe0000: audio clock generator (route_pdc_setReg)
  object sgx    "ram" { size = 64K }   # 0xfce00000: the PowerVR SGX core (the SD system's PVR driver)
  object imgp   "ram" { size = 4K }    # 0xffd00000: an image-processing block (coefficient tables at 0x400)
  object usbh1  "ram" { size = 4K }    # 0xffd8c000: a second USB bridge, same 0x804 register as usbh
  object misc3  "ram" { size = 4K }    # 0xfffd1000: polled by the SD system's userspace (0x840)
  object tmu0x  "ram" { size = 0xfd0 } # 0xffd80030: the rest of each TMU page; the SD system's
  object tmu1x  "ram" { size = 0xfd0 } # kernel touches 0x38, past the three channels modelled
  object tmu2x  "ram" { size = 0xfd0 }
  object pfc    "ram" { size = 64K }   # 0xfffc0000: pin function controller, RDS (0xfffc4000), IEBus (0xfffc9000)

  # -- the memory map --------------------------------------------------------
  map mem 0x00000000 size 8M     = nor
  map mem 0x18100000 size 4K     = extcs
  map mem 0x60000000 size 1G     = dram
  map mem 0xf0000000 size 0x100  = mpcore.scu
  map mem 0xf0000100 size 0x100  = gic.cpu
  map mem 0xf0000200 size 0x100  = mpcore.global
  map mem 0xf0000600 size 0x100  = mpcore.private
  map mem 0xf0001000 size 0x1000 = gic.dist
  map mem 0xf0100000 size 0x1000 = l2
  map mem 0xfe700000 size 4K     = intc
  map mem 0xfe780000 size 8K     = intcs
  map mem 0xfe782000 size 4K     = hpbdmac.status
  map mem 0xfe790000 size 64K    = sram
  map mem 0xfe800000 size 4K     = dbsc0
  map mem 0xfec00000 size 4K     = dbsc1
  map mem 0xff800000 size 4K     = lbsc
  map mem 0xffc00000 size 32K    = misc0
  map mem 0xffc08000 size 0xb00  = hpbdmac.channels
  map mem 0xffc09000 size 0x170  = hpbdmac.common
  map mem 0xffc40000 size 0x100  = gpio0
  map mem 0xffc41000 size 0x100  = gpio1
  map mem 0xffc42000 size 0x100  = gpio2
  map mem 0xffc43000 size 0x100  = gpio3
  map mem 0xffc44000 size 0x100  = gpio4
  map mem 0xffc45000 size 0x100  = gpio5
  map mem 0xffc46000 size 0x100  = gpio6
  map mem 0xffc55000 size 4K     = darc
  map mem 0xffc70000 size 0x38   = i2c0
  map mem 0xffc71000 size 0x38   = i2c1
  map mem 0xffc72000 size 0x38   = i2c2
  map mem 0xffc80000 size 4K     = cpg
  map mem 0xffcc0000 size 4K     = sysc
  map mem 0xffd80000 size 0x30   = tmu0
  map mem 0xffd81000 size 0x30   = tmu1
  map mem 0xffd82000 size 0x30   = tmu2
  map mem 0xffd80030 size 0xfd0  = tmu0x
  map mem 0xffd81030 size 0xfd0  = tmu1x
  map mem 0xffd82030 size 0xfd0  = tmu2x
  map mem 0xffd85000 size 4K     = dma
  map mem 0xffe40000 size 0x100  = scif0
  map mem 0xffe41000 size 0x100  = scif1
  map mem 0xffe42000 size 0x100  = scif2
  map mem 0xffe43000 size 0x100  = scif3
  map mem 0xffe44000 size 0x100  = scif4
  map mem 0xffe45000 size 0x100  = scif5
  map mem 0xffe4c000 size 0x100  = sdhi0
  map mem 0xffe4d000 size 0x100  = sdhi1
  map mem 0xffe4e000 size 0x100  = sdhi2
  map mem 0xffe4f000 size 0x100  = sdhi3
  map mem 0xfff12000 size 4K     = misc1
  map mem 0xffd8a000 size 4K     = audio0
  map mem 0xffd90000 size 8K     = audio1
  map mem 0xffe49000 size 4K     = misc2
  map mem 0xffe70000 size 4K     = usbh
  map mem 0xfffe0000 size 4K     = adg
  map mem 0xfce00000 size 64K    = sgx
  map mem 0xffd00000 size 4K     = imgp
  map mem 0xffd8c000 size 4K     = usbh1
  map mem 0xfffd1000 size 4K     = misc3
  map mem 0xfff80000 size 0x40000 = du
  map mem 0xfffc0000 size 64K    = pfc
  map mem 0xfffc7000 size 0x100  = hspi0 { priority = 1 }
  map mem 0xfffc8000 size 0x100  = hspi1 { priority = 1 }
  map mem 0xfffc6000 size 0x100  = hspi2 { priority = 1 }

  # -- the wires -------------------------------------------------------------
  wire tmu0.irq0   -> gic.spi32       # ID 64: the scheduler tick
  wire tmu1.irq0   -> gic.spi36       # ID 68
  wire mpcore.gt0  -> gic.cpu0ppi11   # ID 27: global timer
  wire mpcore.twd0 -> gic.cpu0ppi13   # ID 29: private timer
  wire mpcore.wdt0 -> gic.cpu0ppi14   # ID 30: private watchdog
  wire sdhi0.irq   -> gic.spi104      # ID 136
  wire sdhi3.irq   -> gic.spi106      # ID 138
  wire sdhi2.irq   -> gic.spi107      # ID 139
  wire gpio0.irq   -> gic.spi141      # ID 173
  wire gpio1.irq   -> gic.spi142      # ID 174
  wire gpio2.irq   -> gic.spi143      # ID 175
  wire gpio3.irq   -> gic.spi144      # ID 176
  wire gpio4.irq   -> gic.spi145      # ID 177
  wire gpio5.irq   -> gic.spi146      # ID 178
  wire gpio6.irq   -> gic.spi147      # ID 179
  wire mapcard.cd  -> gpio2.in26      # GPIO 90: SDHI3's card-detect switch, low when a card is in
  wire mapcard.cd  -> gpio2.in28      # GPIO 92: the same switch as userspace watches it (falling edge)
  wire gpio4.out28 -> subwdt.kick     # GPIO 4.28: the watchdog kick
  wire i2c0.irq    -> gic.spi79       # ID 111
  wire i2c1.irq    -> gic.spi82       # ID 114
  wire i2c2.irq    -> gic.spi80       # ID 112
  wire hspi0.irq   -> gic.spi73       # ID 105
  wire hspi1.irq   -> gic.spi74       # ID 106
  wire hspi2.irq   -> gic.spi75       # ID 107
  wire gpio0.out30 -> psc.reset-req   # GPIO 0.30: requestHardReset asks the MCU for a reset
  wire scif1.irq   -> gic.spi89       # ID 121
  wire scif2.irq   -> gic.spi90       # ID 122
  wire scif3.irq   -> gic.spi91       # ID 123
  wire scif4.irq   -> gic.spi92       # ID 124
  wire scif5.irq   -> gic.spi93       # ID 125
  wire scif3.tx-dreq -> hpbdmac.dreq6
  wire scif3.rx-dreq -> hpbdmac.dreq7
  wire sdhi3.dreq    -> hpbdmac.dreq39   # traced: ch39 serves SDHI3 both ways, reprogrammed per transfer
  wire hpbdmac.grp0  -> gic.spi110   # ID 142: channels 0-10
  wire hpbdmac.grp1  -> gic.spi111   # ID 143
  wire hpbdmac.grp2  -> gic.spi112   # ID 144
  wire hpbdmac.grp3  -> gic.spi113   # ID 145
  wire hpbdmac.grp4  -> gic.spi114   # ID 146
  wire hpbdmac.grp5  -> gic.spi115   # ID 147
  wire hpbdmac.grp6  -> gic.spi116   # ID 148
  wire hpbdmac.grp7  -> gic.spi117   # ID 149
  wire hpbdmac.grp8  -> gic.spi118   # ID 150
  wire hpbdmac.grp9  -> gic.spi119   # ID 151
  wire hpbdmac.grp10 -> gic.spi120   # ID 152
  wire hpbdmac.grp11 -> gic.spi121   # ID 153
  wire gic.irq0    -> cpu.irq
}
