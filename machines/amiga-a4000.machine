# amiga-a4000 - a Commodore Amiga 4000: a 25 MHz 68040 with the AA chip set,
# 2 MiB of chip RAM, 16 MiB of motherboard fast RAM behind Ramsey, and the
# A4000's own IDE port.
#
#   rsemu run amiga-a4000 --media kickstart=kickstart:amiga-os-310-a4000.rom \
#       --media hd0=workbench-311.hdf
#   rsemu run amiga-a4000 --media kickstart=kick.rom --drive hd0=disk.hdf
#   rsemu run amiga-a4000 --media kickstart=kick.rom --media df0=disk.adf --vnc :5900
#
# `hd0` is a whole disk with a Rigid Disk Block, the same image the A600, the
# A1200 and the A3000 boot from; `--media` copies it into memory and the
# guest's writes stay there, `--drive` writes them back to the file.
#
# This board is `amiga-a1200.machine`'s chip set on `amiga-a3000.machine`'s
# 32-bit board, and what is new is the processor, the memory and the disk port.
#
# * **A 68040 at 25 MHz, with its on-chip floating-point unit.** The A4000/040
#   is what Commodore shipped; `-p processor=68ec040` is the part with neither
#   a memory management unit nor an FPU, and `-p processor=68lc040` the one
#   with the MMU and no FPU, both of which went into cost-reduced descendants.
#   The FPU is *on the chip*, so unlike `amiga-a3000.machine` there is no `fpu`
#   property: `src/cpu/m68k/fpu.rs` gives a 68040 one that traps on the
#   instructions a real 68040 does not implement, which is what lets the
#   guest's own `68040.library` finish them. `ExecBase->AttnFlags` reads
#   `$807F` once Workbench is up - `AFF_68010 | AFF_68020 | AFF_68030 |
#   AFF_68040 | AFF_68881 | AFF_68882 | AFF_FPU40` - and `tests/amiga_a4000.rs`
#   asserts the 68040 and `FPU40` bits.
# * **The AA chip set**, exactly `amiga-a1200.machine`'s: Alice and Lisa, both
#   `revision = "aga"`, with 2 MiB of chip RAM. `GfxBase->ChipRevBits0` reads
#   `$1F` once the ROM has a boot device, which the same test asserts.
# * **16 MiB of motherboard fast RAM at `$07000000`**, behind Ramsey - the
#   A4000's four SIMM sockets, full. `-p fast-ram=4M` is a part-populated
#   board, but see the note below about where the ROM looks. This is the part
#   an A1200 has no equivalent of at all, and it is why `mem` is 32 bits wide
#   and why `exec` relocates `ExecBase` out of chip RAM and into `$0700xxxx`.
# * **IDE, and not Gayle's.** See the next section.
#
# ## The IDE port
#
# An A4000's is **not** the A600's and A1200's Gayle port at `$00DA0000`: it is
# the board's own decode at `$00DD2020`, which on an A3000 is where the SCSI
# controller sits. `src/dev/amiga/ide.rs` is the model and its header is the
# ledger; in short, register *n* is four bytes on from register *n*-1 with `A12`
# as the chip select and the data bus byte-swapped - the same wiring Gayle has,
# at a different address - and the port's interrupt is one register at
# `$00DD3020`, read as a word, bit 15, which is the drive's `INTRQ` and not a
# latch in front of it.
#
# **Where those addresses came from is black-box observation**, because the
# A4000 documentation the author has does not print them: the shipped
# Kickstart was booted on this board with the whole of `$00D80000`-`$00DDFFFF`
# and `$00E80000`-`$00EFFFFF` answered by a recorder and nothing else, and what
# it touched is what is modelled. `docs/platforms/amiga.md`, "A4000", has the
# traces. No Kickstart was disassembled to get them.
#
# ## Motherboard fast RAM, and where the ROM looks for it
#
# The *Amiga Hardware Reference Manual*'s A3000 map (Appendix D, p. 315) gives
# `$04000000`-`$07FFFFFF` to motherboard fast RAM and `$08000000`-`$0FFFFFFF`
# to the coprocessor slot. An A4000 fills the **top** of that window: 16 MiB is
# `$07000000`-`$07FFFFFF`, which is what this file maps.
#
# That matters because Kickstart's memory sizing does not search: it starts at
# `$07F7FFF0` and works down (`src/dev/amiga/ramsey.rs` quotes the loop, from
# rsemu's own disassembler). So a board with **less** than 16 MiB has to be
# mapped so that it *ends* at `$07FFFFFF` or the ROM finds nothing there and
# leaves `ExecBase` in chip RAM - which is what `-p fast-ram=4M` on its own
# does, and is a real trap rather than a defect. A smaller fit needs a board
# file of its own, with the `map` statement's address moved up to suit.
#
# `docs/platforms/amiga.md` records the A3000's "fast RAM makes both Kickstarts
# take a `CHK` exception and reboot" as an open bug. **It does not reproduce on
# this tree**, on either board: see that document's A4000 section for the sweep.
#
# ## What is not here
#
# No Zorro II or Zorro III cards, so `$00E80000` and `$40000000` upwards float;
# no A4000T SCSI controller, which its own ROM wants at `$00DD0040` and which
# is why `amiga-os-310-a4000t.rom` finds the drive and then stops; no Gayle, so
# no PCMCIA slot, no identification register at `$00DE1000` and none of the
# Kickstart mirrors Gayle's ROM select makes at `$00E00000` and `$00A80000`.
#
# Written from the *Specification for the Advanced Amiga (AA) Chip Set*
# (Commodore-Amiga, 06/07/91), the *Amiga Hardware Reference Manual* 3rd
# edition (Appendix D, the memory map), *The A3000+ System Specification*
# (§2.2, Ramsey), the *MC68040 User's Manual* and ATA-1 (X3.221-1994). No Amiga
# emulator source, no FPGA reimplementation, no AROS source and no Kickstart
# disassembly was consulted (ROADMAP.md §1).
#
# Empty addresses float rather than fault, for the reason the A500, A600 and
# A3000 files give: Gary acknowledges every range no other chip claims.

machine "amiga-a4000" {
  # -- how much of each memory -----------------------------------------------
  param chip-ram = 2M

  # The four SIMM sockets, full. Read the note above before shrinking it: the
  # window is filled from the top.
  param fast-ram = 16M

  # Every Kickstart that runs on a 4000 is 512 KiB.
  param kickstart-size = 512K

  # Whether Paula keeps stereo output frames for a host audio sink to drain.
  param audio = false

  # The date the battery-backed clock starts at. Never the host's: a device may
  # not read the host clock (CLAUDE.md, determinism), so it is declared, and two
  # runs of this file see the same day.
  param time = "2026-01-01T00:00:00"

  # -- the crystals ----------------------------------------------------------
  #
  # Two trees, as on the A3000: the chip set runs off the 28.37516 MHz PAL
  # crystal, the processor off its own. `-p master=28636360` gives the NTSC
  # chipset, which also needs `standard = "ntsc"` on `agnus` and `denise`.
  param master = 28375160
  param cpu-clock = 25000000

  # Which 68040: `-p processor=68lc040` has no FPU and `-p processor=68ec040`
  # has neither FPU nor MMU. The A4000/040's own is the full part.
  param processor = "68040"

  osc clk    = master Hz
  osc cpuclk = cpu-clock Hz

  space mem { width = 32, endian = "big", unassigned = open-bus }

  # -- the processor ---------------------------------------------------------
  #
  # No `fpu` property: a 68040's is on the die, and naming a coprocessor here
  # is an error rather than an option.
  object cpu "cpu.m68k" {
    clock  = cpuclk
    space  = mem
    engine = "interp"
    model  = processor
  }

  object chipram "ram" { size = chip-ram }
  object fastram "ram" { size = fast-ram }
  object kick    "rom" { size = kickstart-size, image = "kickstart" }

  object custom "amiga.custom" { }
  object paula "amiga.paula" { clock = clk / 8, custom = custom, port = "serial", record = audio }
  object df0 "amiga.floppy" { clock = clk / 8, paula = paula, image = "df0" }

  # -- the AA chip set -------------------------------------------------------
  #
  # Alice counts the beam on the colour clock and does every DMA transfer;
  # Lisa turns the lines Alice hands her into a picture. `reach` is not a
  # property of Alice's: her pointers are twenty bits, which is 2 MiB.
  object agnus "amiga.agnus" {
    clock    = clk / 8
    custom   = custom
    ram      = chipram
    standard = "pal"
    revision = "aga"
    paula    = paula
    video    = denise
  }
  object denise "amiga.denise" { custom = custom, clock = clk / 4, revision = "aga" }

  # -- the battery-backed clock ----------------------------------------------
  osc rtcclk = 32768 Hz
  object rtc "amiga.rtc" { clock = rtcclk, time = time }

  # -- Ramsey ----------------------------------------------------------------
  #
  # The memory controller, as software can see it: two registers, and the
  # reason the board needs them is that Kickstart's memory-sizing routine
  # writes the three mode bits of `$00DE0003` and *spins until they read back*.
  # `version = 15` is `$0F`, the enhanced part - "a version `$0E` or later
  # RAMSEY" (A3000+ System Specification §2.2.2) - which is what an A4000 has
  # where an A3000 has `$0D`. See src/dev/amiga/ramsey.rs.
  object ramsey "amiga.ramsey" { version = 15 }

  object cia_a "mos.8520" { clock = clk / 40 }
  object cia_b "mos.8520" { clock = clk / 40 }
  object cia_a_decode "amiga.cia-decode" { chip = cia_a, lane = "odd"  }
  object cia_b_decode "amiga.cia-decode" { chip = cia_b, lane = "even" }

  # -- the hard disk ---------------------------------------------------------
  #
  # Declared *before* the port, for the reason `amiga-a600.machine` gives:
  # `Machine::reset` runs devices in declaration order and the port's reset
  # reads the drive's interrupt line. No bytes bound to `hd0` is an empty bay.
  object hd0 "ata.disk" { image = "hd0", bay = "ide-master" }

  object ide "amiga.ide" { master = "ide-master", slave = "ide-slave" }

  # -- the overlay -----------------------------------------------------------
  #
  # Gary's overlay decoder, used for exactly that: the ROM at zero while `OVL`
  # is high, chip RAM after. CIA-A's PA0 drives it, as on an A500 and an A3000
  # and unlike an A1200, where it is Gayle's own. No `custom` (bank 6 does not
  # repeat the registers on this board), no `slow-ram`, no `ext`.
  object overlay "amiga.gary" {
    space = mem
    rom   = kick
    ram   = chipram
    size  = chip-ram
  }

  # -- the memory map --------------------------------------------------------
  #
  #   $00000000  chip RAM, behind the overlay                   2 MiB
  #   $00BFD000  CIA-B, even byte lane
  #   $00BFE000  CIA-A, odd byte lane
  #   $00DC0000  the battery-backed clock                       64 KiB
  #   $00DD2000  the IDE port: the task file and its interrupt  8 KiB
  #   $00DE0000  Ramsey: the control and version registers      256 bytes
  #   $00DFF000  the custom chip registers                      512 bytes
  #   $00F80000  Kickstart                                      512 KiB
  #   $07000000  motherboard fast RAM                           16 MiB
  #
  # Everything else floats: Zorro II space and its autoconfig at `$00E80000`,
  # the coprocessor slot at `$08000000`, Zorro III space above `$40000000`.
  map mem 0x00000000 size chip-ram = overlay.overlay { endian = "big" }
  map mem 0x00BFD000 size 0x1000   = cia_b_decode    { endian = "big" }
  map mem 0x00BFE000 size 0x1000   = cia_a_decode    { endian = "big" }
  map mem 0x00DC0000 size 0x10000  = mirror(rtc)     { endian = "big" }
  map mem 0x00DD2000 size 0x2000   = ide.ide         { endian = "big" }
  map mem 0x00DE0000 size 0x100    = ramsey.regs     { endian = "big" }
  map mem 0x00DFF000 size 0x200    = custom
  map mem 0x00F80000 size 512K     = mirror(kick)    { endian = "big" }
  map mem 0x07000000 size fast-ram = fastram        { endian = "big" }

  # -- wiring ----------------------------------------------------------------
  wire cia_a.pa0 -> overlay.ovl

  wire paula.ipl0 -> cpu.ipl0
  wire paula.ipl1 -> cpu.ipl1
  wire paula.ipl2 -> cpu.ipl2

  # INT2 is an open-collector net: CIA-A pulls it, and so does the IDE port -
  # the level Paula reports as PORTS, which is where `scsi.device` puts its
  # handler. INT6 is CIA-B's, as everywhere.
  wire cia_a.irq  -> paula.int2
  wire ide.int2   -> paula.int2
  wire cia_b.irq  -> paula.int6

  # The floppy lines (Appendix E; chapter 8, Table 8-5).
  wire cia_b.pb7 -> df0.mtr   { pull = "up" }    # MTR*
  wire cia_b.pb3 -> df0.sel   { pull = "up" }    # SEL0*
  wire cia_b.pb2 -> df0.side  { pull = "up" }    # SIDE*
  wire cia_b.pb1 -> df0.dir   { pull = "up" }    # DIR
  wire cia_b.pb0 -> df0.step  { pull = "up" }    # STEP*
  wire df0.rdy   -> cia_a.pa5 { pull = "up" }    # RDY*
  wire df0.tk0   -> cia_a.pa4 { pull = "up" }    # TK0*
  wire df0.wpro  -> cia_a.pa3 { pull = "up" }    # WPRO*
  wire df0.chng  -> cia_a.pa2 { pull = "up" }    # CHNG*
  wire df0.index -> cia_b.flag { pull = "up" }   # INDEX*

  wire agnus.vsync -> cia_a.tod
  wire agnus.hsync -> cia_b.tod

  # -- the keyboard and the mouse --------------------------------------------
  osc periph = 1000000 Hz

  object kbd "amiga.keyboard" { clock = periph }
  wire kbd.kclk  -> cia_a.cnt { pull = "up" }
  wire cia_a.sp  -> kbd.kdat  { pull = "up" }
  wire kbd.kdat  -> cia_a.sp

  object mouse "amiga.mouse" { clock = periph }
  wire mouse.y      -> denise.m0v  { pull = "up" }
  wire mouse.yq     -> denise.m0vq { pull = "up" }
  wire mouse.x      -> denise.m0h  { pull = "up" }
  wire mouse.xq     -> denise.m0hq { pull = "up" }
  wire mouse.left   -> cia_a.pa6   { pull = "up" }
  wire mouse.right  -> paula.potly { pull = "up" }
  wire mouse.middle -> paula.potlx { pull = "up" }
}
