# arm926 - a bare ARM926EJ-S SoC skeleton.
#
#   rsemu run arm926 --media firmware=fw.bin
#   rsemu run arm926 -p periph=0xf0000000 -p ram=64M --media firmware=fw.bin
#
# The smallest machine that puts an ARMv5TE core somewhere real: a boot ROM at
# the reset vector, DRAM, and one peripheral aperture. It models no product. It
# exists so that `cpu.arm` has somewhere to run inside a `.machine` file, and so
# that a downstream SoC - the immediate one being a Conexant DigiColor
# CX92755-class part, whose peripherals sit at 0xf0000000 - can start from a
# file it copies and edits rather than from nothing.
#
# ---------------------------------------------------------------------------
# Every address is a parameter, and that is the point
# ---------------------------------------------------------------------------
#
# An ARM9 SoC's memory map is the SoC's, not the architecture's: two parts with
# the same core put their DRAM and their registers in entirely different places.
# So nothing here is a constant except the one address the *architecture* fixes
# - the exception vector base, which is 0x00000000 out of reset unless VINITHI
# is tied high - and that is why the boot ROM is mapped there.
#
# ---------------------------------------------------------------------------
# CP15, and how a machine file asks for one
# ---------------------------------------------------------------------------
#
# `cp15 = arm926ejs` on the core below. That is the whole mechanism: the system
# control coprocessor is a **construction property of the CPU**, the way a
# 6502's `variant` is, because CP15 is part of the CPU rather than a device
# reaching another device. Set it and the core comes up with the VMSAv5 MMU,
# the domain model, the fault registers and the ARM926EJ-S identification
# values; `cp15 = none` gives the bare macrocell, which is what this board was
# before and what it still is bit-for-bit while the MMU is switched off.
#
# What is *not* here is the caches, the write buffer and the tightly-coupled
# memories. Those genuinely do differ between SoCs built on the same macrocell,
# and they remain behind `cp::Coprocessor` and `cp::Mmu` for a downstream crate
# to add - which is what those traits were always for.

machine "arm926" {
  # -- the map ---------------------------------------------------------------

  # How big the boot ROM is. It is mapped at zero because that is where the
  # architecture puts the exception vectors, so the first word of the firmware
  # image is the reset branch.
  param rom = 1M

  # Where DRAM starts and how much there is.
  param ram-base = 0x02000000
  param ram      = 16M

  # The peripheral aperture: where a SoC's register blocks live, and how much
  # address space they get. 0xf0000000 is the CX92755's, which is the reason
  # that is the default rather than a round number chosen for looks.
  param periph      = 0xf0000000
  param periph-size = 64K

  # Which system control coprocessor the core has. `arm926ejs` is the part's
  # own; `none` is the macrocell with CP15 left out, which is a real
  # configuration and is also the way to prove that a board with the MMU
  # switched off behaves identically either way (`-p cp15=none`).
  param cp15 = "arm926ejs"

  # -- the crystal -----------------------------------------------------------
  #
  # One oscillator: everything on this board descends from the same can, so
  # every ratio below is exact (ROADMAP.md 4.2). A real SoC has several - a
  # reference crystal and a PLL per subsystem - and a board file that models one
  # declares them here.
  osc sysclk = 200000000 Hz

  # -- the bus ---------------------------------------------------------------
  #
  # One flat 32-bit space. `unassigned` is left at its default of `fault`, so an
  # access to a hole raises an external abort the guest can see rather than a
  # plausible-looking zero. An ARM *does* have a bus-error input, unlike a 6502,
  # so this is the honest setting rather than an aspirational one.
  space mem { width = 32 }

  # -- the core --------------------------------------------------------------
  #
  # `store-pc-offset = 8` and low vectors are the ARM926EJ-S defaults; they are
  # written out because a board with VINITHI tied high changes the second one,
  # and the file should show where. With a CP15 attached, `high-vectors` and
  # `alignment-faults` are the *reset values* of its c1 `V` and `A` bits, which
  # is exactly what the straps do on real silicon: the guest owns the bits
  # afterwards and can clear either.
  object cpu "cpu.arm" {
    clock            = sysclk
    space            = mem
    engine           = "interp"
    big-endian       = false
    high-vectors     = false
    alignment-faults = false
    store-pc-offset  = 8
    cp15             = cp15
  }

  # -- memory ----------------------------------------------------------------
  #
  # `image` names a media slot: whoever runs the machine binds the bytes
  # (`--media firmware=fw.bin`), and nothing below host/ opens a file.
  object boot "rom" { size = rom, image = "firmware" }

  object dram "ram" { size = ram }

  # The peripheral aperture, backed by plain memory. A SoC file replaces this
  # one object with its own register blocks at their own offsets; until then it
  # is a window firmware can write to and a test can read back, which is what
  # makes this board provable rather than decorative.
  object regs "ram" { size = periph-size }

  # -- the memory map --------------------------------------------------------
  map mem 0x00000000  size rom         = boot    # vectors, then the firmware
  map mem ram-base    size ram         = dram
  map mem periph      size periph-size = regs

  # -- the wires -------------------------------------------------------------
  #
  # None, deliberately. `cpu.irq`, `cpu.fiq` and `cpu.reset` are input pins this
  # core has, and a SoC file wires its interrupt controller to the first two and
  # its watchdog to the third. This board has no interrupt controller to wire,
  # and a net with no driver would be three lines saying nothing.
}
