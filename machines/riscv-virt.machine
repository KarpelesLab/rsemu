# The RISC-V `virt` board — the first machine rsemu boots real system software
# on.
#
#   rsemu run riscv-virt --media firmware=fw.bin
#   rsemu run riscv-virt --media firmware=fw_payload.bin -p ram=256M
#   rsemu run riscv-virt --media firmware=fw_payload.bin --initrd rootfs.cpio \
#       -p ram=512M -p cmdline="console=ttyS0"
#
# There is no such chip as a "virt". This is the board every RISC-V toolchain
# and every RISC-V kernel already knows how to target: one hart, a CLINT for the
# timer, a PLIC for everything else, a 16550 for the console, and virtio-MMIO
# for storage and entropy. No PCI, no ACPI, no legacy — and no hidden
# convention, because **the guest learns the whole layout from a device tree
# rsemu generates from this file** (docs/platforms/riscv-virt.md).
#
# That last point is worth stating plainly: the addresses below are not a
# protocol. Change one, and the generated tree changes with it, and the guest
# follows. They are the conventional RISC-V `virt` numbers because familiar
# addresses are easier to debug, not because anything outside this repository
# requires them.
#
# Sources: the RISC-V Privileged Architecture (CC-BY-4.0) for the CLINT's
# semantics, the RISC-V PLIC specification, the National Semiconductor PC16550D
# data sheet, OASIS VIRTIO 1.2 and the Devicetree Specification. Each device
# module cites the sections it used.

machine "riscv-virt" {
  # How much DRAM the board has. A kernel with a ramdisk wants more than this;
  # `-p ram=1G` is the usual answer.
  param ram = 128M

  # Which character port the console attaches to, so two of these can run in
  # one process without typing at each other (`-p console=b`).
  param console = "console"

  # The kernel command line, handed over as `/chosen/bootargs`.
  param cmdline = ""

  # Where a ramdisk bound to the `initrd` media slot is staged, and what
  # `/chosen/linux,initrd-start` therefore says. It only means anything when
  # something is bound to that slot, so the default is a plain address rather
  # than "off": 128 MiB into DRAM, clear of a kernel loaded at 0x80200000 and
  # of the pages it decompresses into, which needs `ram` to be at least 256M.
  param initrd_addr = 0x88000000

  # Which named power signal a guest's poweroff request lands on, so two of
  # these can run in one process without stopping each other.
  param power = "power"

  # The virtio disk's size. Whatever is bound to the `disk` media slot is the
  # start of it, padded out to this with zeroes — so `-p storage=64M` alone is
  # a blank 64 MiB disk, and `--disk foo.img` alone is exactly that image.
  #
  # Ignored when the *run* backs that slot with a host file instead:
  # `--drive disk=root.qcow2` installs a medium, the medium brings its own
  # capacity, and the guest sees the image's size rather than this one. The two
  # are different contracts and both are supported — bytes in a slot are what a
  # `no_std` or wasm build has, and a file is what keeps a 16 GiB disk out of
  # host memory (docs/buses/storage.md).
  param storage = 16M

  # How big each of the two NOR flash banks is. Two, because that is how a
  # board that boots UEFI is wired: one holds the firmware and one holds the
  # variable store, and the second has to be writable for the firmware to keep
  # anything. See the `flash.cfi` objects below.
  param flash = 32M

  # -- crystals --------------------------------------------------------------
  #
  # Three, because the board has three. RISC-V defines no instruction timing at
  # all, so `core` sets the wall-clock rate and nothing architectural; `rtc` is
  # what `mtime` counts, and it is a genuinely separate can on real hardware,
  # which is why it is its own tree rather than a divider off the core clock
  # (ROADMAP.md §4.2); `uartclk` is the classic 1.8432 MHz UART crystal.
  osc core    = 1000000000 Hz
  osc rtc     = 10000000 Hz
  osc uartclk = 1843200 Hz

  # One flat 64-bit physical space. `unassigned` is left at its default of
  # `fault`, so an access to a hole becomes an access-fault exception the guest
  # can see, rather than a plausible-looking zero — a RISC-V hart *can* report
  # one, unlike a 6502, and hiding it would hide our own memory-map bugs too.
  space mem { width = 64 }

  # -- the hart --------------------------------------------------------------
  #
  # It comes out of reset in the boot ROM at 0x1000, which sets a0 and a1 and
  # jumps to 0x80000000. See `riscv.boot` below.
  # `timer = clint` is what makes `rdtime` read the platform timer rather than
  # zero. `time` is architecturally a view of the CLINT's `mtime`, not a counter
  # the hart owns, so the two hold the same cell — named here rather than found
  # by searching, because a board with two timers must not depend on which one
  # the machine happened to reach first (ROADMAP.md §0).
  object cpu0 "cpu.riscv" {
    clock  = core
    space  = mem
    engine = "interp"
    xlen   = "rv64"
    isa    = "imafdc"
    hartid = 0
    reset  = 0x1000
    timer  = clint
  }

  # -- memory ----------------------------------------------------------------
  #
  # Declared first among the things that are reset, because a cold reset clears
  # it and the loaders at the bottom of this file must run afterwards.
  object dram "ram" { size = ram }

  # -- the timer -------------------------------------------------------------
  #
  # `timebase` is the same number as `osc rtc` above, and has to be: the clock
  # domain is what `mtime` actually counts, and `timebase` is what the device
  # tree tells the guest it counts at. They are written twice because a device
  # cannot read its own domain's frequency — `BindCtx` carries the domain but
  # not the clock forest — and that is a seam to close, not a design.
  #
  # This counter is what `cpu0`'s `time` CSR reads: see `timer = clint` above.
  object clint "riscv.clint" {
    clock    = rtc
    harts    = 1
    timebase = 10000000
  }

  # -- the interrupt controller ---------------------------------------------
  #
  # Two contexts for the one hart: machine mode for the firmware, supervisor
  # mode for the kernel it starts.
  object plic "riscv.plic" {
    sources    = 31
    harts      = 1
    supervisor = true
  }

  # -- the console -----------------------------------------------------------
  #
  # The clock is the chip's character rate: one tick is one opportunity to move
  # a byte between the FIFOs and the host, and the scheduler is the only thing
  # allowed to decide when that happens.
  object uart "uart.ns16550" {
    clock     = uartclk / 16
    port      = console
    frequency = 1843200
  }

  # -- power -----------------------------------------------------------------
  #
  # How a guest stops the machine on purpose. `signals::open("power")` is the
  # host's end; a headless test watches it instead of watching a timeout.
  object test "riscv.syscon" { signal = power }

  # -- virtio ----------------------------------------------------------------
  #
  # Both are bus masters and walk their own descriptor rings, so both declare
  # the space that DMA traverses (ROADMAP.md §4.4).
  # The disk's bytes come from the `disk` media slot, and the machine file says
  # a slot name rather than a host path because a machine file is portable data
  # describing a board. What is behind that name is the run's business:
  #
  #   rsemu run riscv-virt --disk rootfs.img          # bytes, copied into RAM
  #   rsemu run riscv-virt --drive disk=root.qcow2    # a file, left on disk
  object blk "virtio.blk" {
    space  = mem
    size   = storage
    image  = "disk"
    serial = "rsemu-virt-0"
  }

  object rng "virtio.rng" {
    space = mem
    # Deterministic by construction: the same seed gives the same bytes every
    # run, because rsemu has no record/replay seam for host entropy yet and a
    # machine that drew from one would not be reproducible (ROADMAP.md §0).
    # This is not a security primitive and the device tree does not claim it is.
    seed = 1
  }

  # -- NOR flash -------------------------------------------------------------
  #
  # Two banks of parallel NOR, which is what makes a UEFI build able to *keep*
  # a variable rather than merely read one. RAM at these addresses gets a
  # firmware as far as the DXE dispatcher and no further: EDK2's
  # `VirtNorFlashDxe` will not install `gEfiVariableWriteArchProtocolGuid`
  # against memory, because fault-tolerant write needs erase-and-program
  # semantics that memory cannot provide (docs/platforms/riscv-virt.md).
  #
  # Each bank is two x16 parts on the 32-bit bus, which is how boards actually
  # wire them and what the driver above assumes: it writes every command into
  # both halves of a word and folds the two status registers back together.
  # 256 KiB erase blocks, which is the granularity the variable store, the
  # fault-tolerant-write working block and its spare are each laid out in.
  #
  # The guest finds them the same way it finds everything else here — the
  # generated device tree gets a `cfi-flash` node per bank, with the address
  # and size read back out of the `map` statements below.
  #
  #   rsemu run riscv-virt --media flash0=edk2-riscv-code.fd \
  #                        --media flash1=edk2-riscv-vars.fd
  #
  # `flash0` is `readonly`: the bank a board boots from has `WP#` tied low, and
  # firmware that is not meant to be guest-updatable should be refused rather
  # than silently corrupted. `flash1` is not, and is the whole point.
  object flash0 "flash.cfi" {
    size     = flash
    image    = "flash0"
    block    = 256K
    readonly = true
  }

  object flash1 "flash.cfi" {
    size  = flash
    image = "flash1"
    block = 256K
  }

  # -- the reset vector and the device tree ----------------------------------
  #
  # Five instructions at 0x1000 and, just below them, a device tree generated
  # from everything above at reset time. `harts`, `isa` and `mmu` are declared
  # here rather than derived because a hart is not a region in any address
  # space, so the generator cannot see one; everything with an address — every
  # `reg`, every `interrupts` — comes out of the realized machine.
  object boot "riscv.boot" {
    space    = mem
    entry    = 0x80000000
    harts    = 1
    isa      = "rv64imafdc"
    mmu      = "sv39"
    bootargs = cmdline
    timebase = 10000000
    model    = "rsemu riscv-virt"
    # Described here, placed by the `initrd` loader at the bottom of this file.
    # The same media slot is named twice on purpose: the length comes out of
    # the bytes in both places, so the only thing written down twice is the
    # address, and a wrong one shows up in the generated tree.
    initrd      = "initrd"
    initrd-addr = initrd_addr
  }

  # -- the memory map --------------------------------------------------------
  map mem 0x00001000 size 0x0000f000 = boot   # reset vector, then the DTB
  map mem 0x00100000 size 0x00001000 = test   # poweroff and reboot
  map mem 0x02000000 size 0x00010000 = clint  # mtime, mtimecmp, msip
  map mem 0x0c000000 size 0x00400000 = plic   # priority, enable, claim
  map mem 0x10000000 size 0x00000100 = uart   # eight registers, sixteen times
  map mem 0x10001000 size 0x00001000 = blk
  map mem 0x10002000 size 0x00001000 = rng
  map mem 0x20000000 size flash      = flash0  # NOR: the firmware bank
  map mem 0x22000000 size flash      = flash1  # NOR: the variable store
  map mem 0x80000000 size ram        = dram

  # -- interrupts ------------------------------------------------------------
  #
  # The PLIC source numbers below are the *only* place they are written: the
  # generated device tree reads each device's `interrupts` property back out of
  # this wiring, by asking the PLIC which source the net landed on.
  wire clint.mtip0 -> cpu0.mtip
  wire clint.msip0 -> cpu0.msip
  wire plic.meip0  -> cpu0.meip
  wire plic.seip0  -> cpu0.seip
  wire uart.irq    -> plic.irq10
  wire blk.irq     -> plic.irq1
  wire rng.irq     -> plic.irq2
  wire test.reset  -> cpu0.reset

  # -- what gets loaded ------------------------------------------------------
  #
  # Last, and that is load-bearing: `Machine::reset` runs devices in declaration
  # order, a cold reset zeroes `dram`, and a firmware image written before that
  # would be erased by the reset that ends realize.
  object fw "riscv.loader" {
    space = mem
    image = "firmware"
    addr  = 0x80000000
  }

  # The ramdisk, if one was bound. An unbound slot is empty bytes, and an empty
  # image loads nothing — so this object costs a machine with no initrd
  # nothing but the line it is written on.
  object initrd "riscv.loader" {
    space = mem
    image = "initrd"
    addr  = initrd_addr
  }
}
