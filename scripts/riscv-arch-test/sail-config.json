// Teaching the Sail RISC-V model to describe rsemu's hart.
//
// Copyright (c) 2026 the rsemu authors. MIT.
//
// This is a `--config-override` for `sail_riscv_sim`, layered on its own
// default configuration. It exists because a reference signature is only
// evidence about *this* hart if the model that produced it implements the same
// hart, and Sail's default enables very nearly everything: the hypervisor
// extension, the vector extension, bit-manipulation, the crypto extensions,
// Zcb, Zfa, Sv48 and Sv57.
//
// That is not a hypothetical. Before this file existed, three tests —
// `privilege/ecall`, `privilege/ebreak` and `C/cebreak-01` — differed from the
// reference, and the diff was a single bit in the first word of the trap
// signature. riscv-arch-test's own trap handler reads `misa` and takes a
// different path when the H bit is set (`arch_test.h`, `xcpt_sig_sv`), so the
// reference was recording a six-word hypervisor trap entry while rsemu, having
// no H bit, recorded four. Both were right about their own hart. Turning H off
// here made all three agree, and no change to rsemu was warranted or made.
//
// What is described: RV64GC (or RV32GC with `--rv32` plus sail-rv32.json) with
// machine, supervisor and user mode, Zicsr, Zifencei and Sv39 — which is
// exactly `rsemu::cpu::riscv::Config::rv64gc`.
{
  "base": {
    // rsemu's `misa` ignores writes (src/cpu/riscv/csr.rs, `num::MISA => {}`),
    // which the specification allows: misa is WARL and an implementation may
    // hold every field constant.
    "writable_misa": false,
    // Sail validates that no reserved exception is delegatable, and turning H
    // off makes cause 10 (ECALL from VS-mode) reserved — so the default mask
    // has to lose bit 10 along with the guest-page-fault and Zicfiss bits.
    // What is left is causes 0..9, 12, 13 and 15.
    "medeleg": {
      "delegatable_bits": { "len": 64, "value": "0x0000_0000_0000_B3FF" }
    }
  },
  "extensions": {
    // Not implemented by rsemu's RISC-V core. Each of these would otherwise
    // show up in `misa`, in an instruction that should be illegal, or in a CSR
    // that should not exist.
    "V": { "support_level": "Disabled" },
    "B": { "supported": false },
    "H": { "supported": false },
    "Zibi": { "supported": false },
    "Zicbom": { "supported": false },
    "Zicbop": { "supported": false },
    "Zicboz": { "supported": false },
    "Zicfilp": { "supported": false },
    "Zicfiss": { "supported": false },
    "Zicond": { "supported": false },
    "Zilx": { "supported": false },
    "Zimop": { "supported": false },
    "Zabha": { "supported": false },
    "Zacas": { "supported": false },
    "Zawrs": { "supported": false },
    "Zfa": { "supported": false },
    "Zfbfmin": { "supported": false },
    "Zfh": { "supported": false },
    "Zfhmin": { "supported": false },
    "Zfinx": { "supported": false },
    "Zdinx": { "supported": false },
    "Zcb": { "supported": false },
    "Zcmop": { "supported": false },
    "Zba": { "supported": false },
    "Zbb": { "supported": false },
    "Zbs": { "supported": false },
    "Zbc": { "supported": false },
    "Zbkb": { "supported": false },
    "Zbkc": { "supported": false },
    "Zbkx": { "supported": false },
    "Zknd": { "supported": false },
    "Zkne": { "supported": false },
    "Zknh": { "supported": false },
    "Zkr": { "supported": false },
    "Zksed": { "supported": false },
    "Zksh": { "supported": false },
    "Zkt": { "supported": false },
    "Zhinx": { "supported": false },
    "Zhinxmin": { "supported": false },
    "Zvabd": { "supported": false },
    "Zvfbfmin": { "supported": false },
    "Zvfbfwma": { "supported": false },
    "Zvfh": { "supported": false },
    "Zvfhmin": { "supported": false },
    "Zvbb": { "supported": false },
    "Zvbc": { "supported": false },
    "Zvkb": { "supported": false },
    "Zvkg": { "supported": false },
    "Zvkned": { "supported": false },
    "Zvknha": { "supported": false },
    "Zvknhb": { "supported": false },
    "Zvksed": { "supported": false },
    "Zvksh": { "supported": false },
    "Zvkt": { "supported": false },
    // rsemu implements Sv39 (and Sv32 on RV32) and nothing wider.
    "Sv48": { "supported": false },
    "Sv57": { "supported": false },
    "Svinval": { "supported": false },
    "Svnapot": { "supported": false },
    "Svpbmt": { "supported": false },
    // No `stimecmp`: rsemu's S-mode timer interrupt comes from the CLINT
    // through SBI, not from Sstc.
    "Sstc": { "supported": false },
    // These only exist to describe a hypervisor, and Sail refuses a
    // configuration that keeps them once H is off.
    "Shcounterenw": { "supported": false },
    "Shgatpa": { "supported": false },
    "Shtvala": { "supported": false },
    "Shvstvecd": { "supported": false },
    "Shvsatpa": { "supported": false },
    "Shvstvala": { "supported": false }
  }
}
